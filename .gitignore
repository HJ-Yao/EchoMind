# ==========================================
# QQBot Project - Git 忽略文件
# ==========================================

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# Node
node_modules/
dist/
*.log
npm-debug.log*

# === 敏感信息 / 环境变量 ===
# 本地环境变量（可能包含真实密码、Token、API Key）
.env.local
.env.*.local
.env.development.local
.env.production.local

# Spring Boot 本地配置覆盖（可能包含数据库密码等）
application-local.yml
application-local.yaml
application-*.yml.local
**/resources/application-local.*

# Docker Compose 本地覆盖 + 环境变量文件（可能含密码）
docker-compose.override.yml
.env.secrets
.env.secrets.*

# 凭证/私钥文件
*credentials*
*secret*
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# 部署
docker-compose.override.yml

# 临时文件
*.tmp
*.bak
*.orig
